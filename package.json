{
  "name": "sticky-todo",
  "version": "1.0.0",
  "description": "A small always-on-top to-do note",
  "main": "main.js",
  "author": "You",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.local.stickytodo",
    "productName": "Sticky Todo",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "dates.js",
      "styles.css"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
